<?xml version="1.0" encoding="utf-8"?>
<!--
  Project Kaos-Byte4.1.0v (The Static Rift) - Xbox 360 XDK project (Visual Studio 2010 + Xbox 360 SDK 2.0.21xxx).
  Configurations:
    Release | Xbox 360               -> bin\Release\KaosByteDSL.xex  (Dashlaunch system plugin)
    Release_PeerPressure | Xbox 360  -> bin\Release_PeerPressure\KaosByte.xex
                                        (title DLL for Peer Pressure's DLL sideloading)

  xkelib: put (or junction) an xkelib checkout at .\xkelib next to this file, or pass
  /p:XkelibDir=C:\path\to\xkelib to msbuild. Build xkelib once for your SDK version first so
  kernelext.lib / xamext.lib exist (xkelib.h links them with #pragma comment).
-->
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Xbox 360">
      <Configuration>Debug</Configuration>
      <Platform>Xbox 360</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Xbox 360">
      <Configuration>Release</Configuration>
      <Platform>Xbox 360</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release_PeerPressure|Xbox 360">
      <Configuration>Release_PeerPressure</Configuration>
      <Platform>Xbox 360</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5C3B7E52-1D4A-4C6B-9A3E-7F21B0D4E8A1}</ProjectGuid>
    <Keyword>Xbox360Proj</Keyword>
    <RootNamespace>KaosByte</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <XkelibDir Condition="'$(XkelibDir)'==''">$(MSBuildProjectDirectory)\xkelib</XkelibDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Xbox 360'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>MultiByte</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Xbox 360'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>MultiByte</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_PeerPressure|Xbox 360'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>MultiByte</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\</IntDir>
    <ImageXexOutput>$(OutDir)KaosByteDSL.xex</ImageXexOutput>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_PeerPressure|Xbox 360'">
    <ImageXexOutput>$(OutDir)KaosByte.xex</ImageXexOutput>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ExceptionHandling>false</ExceptionHandling>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <AdditionalIncludeDirectories>src\core;src\xbox;$(XkelibDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>xapilib.lib;xboxkrnl.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(XkelibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalOptions>/dll /ALIGN:128,4096 %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <ImageXex>
      <ConfigurationFile>xex.xml</ConfigurationFile>
    </ImageXex>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Xbox 360'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;_XBOX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Xbox 360'">
    <ClCompile>
      <Optimization>Full</Optimization>
      <FavorSizeOrSpeed>Size</FavorSizeOrSpeed>
      <StringPooling>true</StringPooling>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;_XBOX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <SetChecksum>true</SetChecksum>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release_PeerPressure|Xbox 360'">
    <ClCompile>
      <Optimization>Full</Optimization>
      <FavorSizeOrSpeed>Size</FavorSizeOrSpeed>
      <StringPooling>true</StringPooling>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;_XBOX;SKYPORTAL_SIDELOAD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <SetChecksum>true</SetChecksum>
    </Link>
    <ImageXex>
      <ConfigurationFile>xex_sideload.xml</ConfigurationFile>
    </ImageXex>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="src\core\portal_core.h" />
    <ClInclude Include="src\core\sp_lock.h" />
    <ClInclude Include="src\xbox\config.h" />
    <ClInclude Include="src\xbox\figures.h" />
    <ClInclude Include="src\xbox\hooks.h" />
    <ClInclude Include="src\xbox\stdafx.h" />
    <ClInclude Include="src\xbox\util.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\core\portal_core.cpp" />
    <ClCompile Include="src\xbox\config.cpp" />
    <ClCompile Include="src\xbox\figures.cpp" />
    <ClCompile Include="src\xbox\hooks.cpp" />
    <ClCompile Include="src\xbox\main.cpp" />
    <ClCompile Include="src\xbox\util.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xex.xml" />
    <None Include="xex_sideload.xml" />
    <None Include="dist\SkyPortal\skyportal.ini" />
    <None Include="dist\peerpressure\SideLoading\41560911.ini" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
